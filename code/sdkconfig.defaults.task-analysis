# Task-analysis variant - native equivalent of platformio [env:esp32cam-dev-task-analysis].
# FreeRTOS run-time stats + heap task tracking for profiling (pairs with the TASK_ANALYSIS_ON code
# path, added as a -D in CMakeLists). Adds overhead - a dev/profiling build, not for production.
CONFIG_FREERTOS_USE_TRACE_FACILITY=y
CONFIG_FREERTOS_GENERATE_RUN_TIME_STATS=y
CONFIG_FREERTOS_VTASKLIST_INCLUDE_COREID=y
CONFIG_HEAP_TASK_TRACKING=y
