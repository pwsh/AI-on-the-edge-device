# Power-management variant - DFS (dynamic frequency scaling) + automatic light sleep via tickless idle.
#
# ESP32-S3 ONLY. On the classic ESP32 / ESP32-CAM this is NOT feasible: the 20 MHz camera XCLK can
# only be sourced from APB (the ESP32 LEDC has no XTAL clock source), so DFS scaling APB drifts the
# XCLK and corrupts captures - the only safe option is to pin APB at max for the whole uptime, which
# negates any benefit. The S3's LEDC has an XTAL (40 MHz) source that is DFS-independent (40/2 =
# 20 MHz), so PM can coexist with the camera there. See PLAN sec 9.3 item 2 for the full analysis.
#
# OPT-IN, validate on hardware first (confirm the XCLK resolves to XTAL; check images across
# lighting; a power meter is needed to quantify the modest, always-on-Wi-Fi benefit).
CONFIG_PM_ENABLE=y
CONFIG_PM_DFS_INIT_AUTO=y
CONFIG_FREERTOS_USE_TICKLESS_IDLE=y
