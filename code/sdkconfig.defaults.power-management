# Power-management variant - native equivalent of platformio [env:esp32cam-power-management].
# DFS (dynamic frequency scaling) + automatic light sleep via tickless idle.
#
# OPT-IN, validate on hardware first: DFS scales the APB clock, which can disturb the camera XCLK
# (generated by LEDC) and corrupt captures -> bad reads. The esp32-camera driver must hold an
# ESP_PM_APB_FREQ_MAX lock during capture for this to be safe. See PLAN sec 9.3 item 2. A power
# meter is needed to quantify the (modest, on a Wi-Fi-connected always-on device) benefit.
CONFIG_PM_ENABLE=y
CONFIG_PM_DFS_INIT_AUTO=y
CONFIG_FREERTOS_USE_TICKLESS_IDLE=y
